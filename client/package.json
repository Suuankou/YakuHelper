
{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k --kill-signal SIGINT -n CLIENT, \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "cd ../server && uv run uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm run build:client",
    "build:client": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "htmx.org": "^2.0.11",
    "typescript-language-server": "^6.1.0"
  }
}
